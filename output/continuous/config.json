{
  "model_name": "gpt2",
  "data_path": "output/continuous/jetstream_data.jsonl",
  "output_dir": "output/continuous",
  "epochs": 3,
  "learning_rate": 0.00003,
  "batch_size": 16,
  "gradient_accumulation_steps": 8,
  "max_seq_len": 512,
  "precision": "f32",
  "warmup_steps": 300,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "seed": 42,
  "enable_load_monitoring": true,
  "max_cpu_load": 0.8,
  "load_check_interval": 10
}